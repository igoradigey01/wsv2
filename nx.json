{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "cache": true
    },
    "e2e": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "build-storybook": {
      "inputs": [
        "default",
        "^production",
        "{projectRoot}/.storybook/**/*",
        "{projectRoot}/tsconfig.storybook.json"
      ],
      "cache": true
    },
    "@angular-devkit/build-angular:browser": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "e2e-ci--**/**": {
      "dependsOn": ["^skladhs:build"]
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/tsconfig.storybook.json"
    ],
    "sharedGlobals": []
  },
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "cypress",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "jest"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest"
    },
    "@nx/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@nx/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@nx/angular:service": {
      "type": "service"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@nx/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@nx/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@nx/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@nx/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@nx/angular:resolver": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "affected": {
    "defaultBase": "main",
    "legacy": true
  },
  "plugins": [
    {
      "plugin": "@nx/cypress/plugin",
      "options": {
        "targetName": "cypress:e2e",
        "openTargetName": "open-cypress",
        "componentTestingTargetName": "component-test",
        "ciTargetName": "e2e-ci"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "eslint:lint",
        "extensions": ["ts", "tsx", "js", "jsx", "html", "vue"]
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": [
        "apps/hadjoh01/**/*",
        "apps/presentation01/**/*",
        "apps/shagen01/**/*",
        "apps/skladsh/**/*",
        "apps/x01/**/*",
        "apps/xf01/**/*",
        "apps/xl-01/**/*",
        "libs/account/**/*",
        "libs/account-service/**/*",
        "libs/admin-page/**/*",
        "libs/app-common/**/*",
        "libs/app-config/**/*",
        "libs/app-layout/**/*",
        "libs/app-styles/**/*",
        "libs/js-pdf/**/*",
        "libs/manage-page/**/*",
        "libs/shop-cart/**/*",
        "libs/shop-content/**/*",
        "libs/shop-information/**/*",
        "libs/shop-opt/**/*",
        "libs/shop-order/**/*",
        "libs/ui/**/*",
        "libs/user-order/**/*",
        "libs/user-profile/**/*"
      ]
    },
    {
      "plugin": "@nx/cypress/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci",
        "componentTestingTargetName": "component-test",
        "openTargetName": "open-cypress"
      },
      "include": [
        "apps/hadjoh01-e2e/**/*",
        "apps/presentation01-e2e/**/*",
        "apps/shagen01-e2e/**/*",
        "apps/x01-e2e/**/*",
        "apps/xf01-e2e/**/*",
        "apps/xl-01-e2e/**/*"
      ]
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/hadjoh01/**/*",
        "apps/hadjoh01-e2e/**/*",
        "apps/presentation01/**/*",
        "apps/presentation01-e2e/**/*",
        "apps/shagen01/**/*",
        "apps/shagen01-e2e/**/*",
        "apps/skladsh/**/*",
        "apps/x01/**/*",
        "apps/x01-e2e/**/*",
        "apps/xf01/**/*",
        "apps/xf01-e2e/**/*",
        "apps/xl-01/**/*",
        "apps/xl-01-e2e/**/*",
        "libs/account/**/*",
        "libs/account-service/**/*",
        "libs/admin-page/**/*",
        "libs/app-common/**/*",
        "libs/app-config/**/*",
        "libs/app-layout/**/*",
        "libs/app-styles/**/*",
        "libs/js-pdf/**/*",
        "libs/manage-page/**/*",
        "libs/shop-cart/**/*",
        "libs/shop-content/**/*",
        "libs/shop-information/**/*",
        "libs/shop-opt/**/*",
        "libs/shop-order/**/*",
        "libs/ui/**/*",
        "libs/user-order/**/*",
        "libs/user-profile/**/*"
      ]
    }
  ]
}
