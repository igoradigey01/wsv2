{
  "name": "xf-shared",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/xf-shared/src",
  "prefix": "wsv2",
  "tags": ["scope:01app-xf-shared-lib", "type:01-lib"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/xf-shared/ng-package.json",
        "tsConfig": "libs/xf-shared/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/xf-shared/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    }
  }
}
