# Several third-party Angular libraries in this workspace still declare peer
# dependencies for Angular 16 and older (angular8-yandex-maps, ng-qrcode,
# ngx-image-cropper, @abacritt/angularx-social-login), while the workspace runs
# Angular 18. yarn v1 silently ignored those conflicts, npm refuses to install.
# TODO: remove this flag after the Angular/Nx upgrade (Step 2) and bumping the
# libraries above to versions that support the new Angular major.
legacy-peer-deps=true
